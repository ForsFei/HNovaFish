{
  "name": "hnova-fish",
  "displayName": "HNova Fish · 随手读",
  "description": "在 VS Code 中只读浏览贴吧、知乎，支持收藏、历史与专注阅读。",
  "version": "0.1.43",
  "publisher": "hnova",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:hnovaFish.feed",
    "onView:hnovaFish.reader"
  ],
  "scripts": {
    "compile": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "commands": [
      {
        "command": "hnovaFish.connectBrowser",
        "title": "连接贴吧浏览器",
        "category": "HNova Fish",
        "icon": "$(plug)"
      },
      {
        "command": "hnovaFish.browserFolder",
        "title": "打开浏览器配套扩展文件夹",
        "category": "HNova Fish"
      },
      {
        "command": "hnovaFish.disconnectBrowser",
        "title": "断开浏览器并使用直接请求",
        "category": "HNova Fish"
      },
      {
        "command": "hnovaFish.previousArticle",
        "title": "上一篇帖子/文章",
        "category": "HNova Fish"
      },
      {
        "command": "hnovaFish.nextArticle",
        "title": "下一篇帖子/文章",
        "category": "HNova Fish"
      },
      {
        "command": "hnovaFish.bossKey",
        "title": "老板键：隐藏侧栏并返回编辑器",
        "category": "HNova Fish"
      },
      {
        "command": "hnovaFish.configureShortcuts",
        "title": "设置阅读快捷键和老板键",
        "category": "HNova Fish"
      },
      {
        "command": "hnovaFish.refresh",
        "title": "刷新列表",
        "category": "HNova Fish",
        "icon": "$(refresh)"
      },
      {
        "command": "hnovaFish.addForum",
        "title": "添加贴吧",
        "category": "HNova Fish",
        "icon": "$(add)"
      },
      {
        "command": "hnovaFish.openUrl",
        "title": "阅读帖子链接",
        "category": "HNova Fish",
        "icon": "$(link)"
      },
      {
        "command": "hnovaFish.cookie",
        "title": "设置或清除登录 Cookie",
        "category": "HNova Fish",
        "icon": "$(key)"
      },
      {
        "command": "hnovaFish.hide",
        "title": "隐藏阅读窗口",
        "category": "HNova Fish",
        "icon": "$(eye-closed)"
      },
      {
        "command": "hnovaFish.clearHistory",
        "title": "清空阅读历史",
        "category": "HNova Fish"
      },
      {
        "command": "hnovaFish.focusReader",
        "title": "打开阅读窗口",
        "category": "HNova Fish",
        "icon": "$(open-preview)"
      },
      {
        "command": "hnovaFish.reloadReader",
        "title": "重新加载正文",
        "category": "HNova Fish",
        "icon": "$(refresh)"
      },
      {
        "command": "hnovaFish.browseForum",
        "title": "浏览其他贴吧",
        "category": "HNova Fish",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hnovaFish",
          "title": "随手读",
          "icon": "media/fish.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "hnovaFishReading",
          "title": "随手读 · 阅读",
          "icon": "media/fish.svg"
        }
      ],
      "panel": [
        {
          "id": "hnovaFishReadingPanel",
          "title": "随手读 · 阅读",
          "icon": "media/fish.svg"
        }
      ]
    },
    "views": {
      "hnovaFish": [
        {
          "id": "hnovaFish.feed",
          "name": "随手读"
        }
      ],
      "hnovaFishReading": [
        {
          "id": "hnovaFish.reader",
          "name": "阅读",
          "type": "webview",
          "when": "config.hnovaFish.readerPosition != bottom"
        }
      ],
      "hnovaFishReadingPanel": [
        {
          "id": "hnovaFish.readerBottom",
          "name": "阅读",
          "type": "webview",
          "when": "config.hnovaFish.readerPosition == bottom"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "hnovaFish.connectBrowser",
          "when": "view == hnovaFish.feed",
          "group": "navigation"
        },
        {
          "command": "hnovaFish.configureShortcuts",
          "when": "view == hnovaFish.feed || (view == hnovaFish.reader || view == hnovaFish.readerBottom)",
          "group": "settings"
        },
        {
          "command": "hnovaFish.refresh",
          "when": "view == hnovaFish.feed",
          "group": "navigation"
        },
        {
          "command": "hnovaFish.addForum",
          "when": "view == hnovaFish.feed",
          "group": "navigation"
        },
        {
          "command": "hnovaFish.openUrl",
          "when": "view == hnovaFish.feed",
          "group": "navigation"
        },
        {
          "command": "hnovaFish.cookie",
          "when": "view == hnovaFish.feed",
          "group": "settings"
        },
        {
          "command": "hnovaFish.reloadReader",
          "when": "(view == hnovaFish.reader || view == hnovaFish.readerBottom)",
          "group": "navigation"
        },
        {
          "command": "hnovaFish.browseForum",
          "when": "view == hnovaFish.feed",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hnovaFish.previousArticle",
        "key": "left",
        "when": "(hnovaFish.readerFocused || focusedView == hnovaFish.reader || focusedView == hnovaFish.readerBottom || focusedView == hnovaFish.feed) && !inputFocus"
      },
      {
        "command": "hnovaFish.nextArticle",
        "key": "right",
        "when": "(hnovaFish.readerFocused || focusedView == hnovaFish.reader || focusedView == hnovaFish.readerBottom || focusedView == hnovaFish.feed) && !inputFocus"
      },
      {
        "command": "hnovaFish.bossKey",
        "key": "numpad0"
      },
      {
        "command": "hnovaFish.hide",
        "key": "ctrl+alt+;",
        "mac": "cmd+alt+;"
      }
    ],
    "configuration": {
      "title": "HNova Fish",
      "properties": {
        "hnovaFish.tiebaAccessMode": {
          "type": "string",
          "enum": [
            "direct",
            "browser"
          ],
          "default": "direct",
          "enumDescriptions": [
            "通过插件直接请求贴吧",
            "通过本机 Edge 配套扩展读取贴吧"
          ],
          "description": "贴吧访问方式。浏览器模式需要运行连接命令并保持配套扩展连接页打开。"
        },
        "hnovaFish.forums": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "图拉丁"
          ],
          "description": "关注的贴吧名称，不含末尾的吧字。"
        },
        "hnovaFish.showImages": {
          "type": "boolean",
          "default": false,
          "description": "允许加载正文远程图片（会向图片服务发送网络请求）。"
        },
        "hnovaFish.fontSize": {
          "type": "number",
          "default": 15,
          "minimum": 12,
          "maximum": 24,
          "description": "正文字号。"
        },
        "hnovaFish.fontBrightness": {
          "type": "integer",
          "default": 100,
          "minimum": 70,
          "maximum": 130,
          "description": "正文和评论的字体亮度。100% 使用当前主题原色，低于 100% 调暗，高于 100% 调亮。"
        },
        "hnovaFish.tiebaUserAgent": {
          "type": "string",
          "default": "",
          "pattern": "^[^\\r\\n]*$",
          "description": "可选：复制登录贴吧的同一浏览器请求标头中的 User-Agent（仅填值）。空值使用默认请求标头；不会自动解决百度设备验证。"
        },
        "hnovaFish.readerPosition": {
          "type": "string",
          "enum": [
            "right",
            "bottom"
          ],
          "enumDescriptions": [
            "右侧阅读栏",
            "下方阅读面板"
          ],
          "default": "right",
          "description": "阅读位置，修改后立即切换并保留当前文章。"
        }
      }
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "json-bigint": "^1.0.0",
    "tough-cookie": "^6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ForsFei/HNovaFish.git"
  },
  "homepage": "https://github.com/ForsFei/HNovaFish#readme",
  "bugs": {
    "url": "https://github.com/ForsFei/HNovaFish/issues"
  }
}
